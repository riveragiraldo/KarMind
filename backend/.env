# =========================================================
# 🛡️ SEGURIDAD
# ---------------------------------------------------------
# SECRET_KEY:
#   Clave secreta generada por Django para cifrar sesiones,
#   tokens y otros componentes sensibles del framework.
#   ⚠️ Nunca debe compartirse ni publicarse.
#
# DEBUG:
#   Define si el modo de depuración está activo.
#   - True: muestra errores detallados (solo para desarrollo)
#   - False: oculta errores y protege la aplicación (producción)
#
# ALLOWED_HOSTS:
#   Lista separada por comas de los dominios o direcciones IP
#   autorizadas para servir la aplicación.
# =========================================================
SECRET_KEY=django-insecure-@Mi_Clave_Secreta
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost


# =========================================================
# 🗄️ BASE DE DATOS POSTGRESQL
# ---------------------------------------------------------
# DB_NAME:
#   Nombre de la base de datos a la cual se conectará Django.
#
# DB_USER:
#   Usuario autorizado para acceder a la base de datos.
#
# DB_PASSWORD:
#   Contraseña del usuario de la base de datos.
#
# DB_HOST:
#   Dirección del servidor de base de datos.
#   - 'localhost' si se ejecuta en el mismo equipo.
#
# DB_PORT:
#   Puerto de conexión del servicio PostgreSQL (por defecto 5432).
# =========================================================
DB_NAME=karmind_db
DB_USER=postgres
DB_PASSWORD=Comput2011*
DB_HOST=localhost
DB_PORT=5432


# =========================================================
# 🔐 CLAVES DE reCAPTCHA (Google)
# ---------------------------------------------------------
# RECAPTCHA_PUBLIC_KEY:
#   Clave pública que se incluye en el frontend para generar el
#   widget reCAPTCHA.
#
# RECAPTCHA_PRIVATE_KEY:
#   Clave privada utilizada por el servidor para verificar las
#   respuestas del usuario con los servicios de Google.
#
# ⚠️ Ambas claves deben mantenerse seguras y no compartirse.
# =========================================================
RECAPTCHA_PUBLIC_KEY='6LfXqAIsAAAAAKHt47KLX-c0xY1fs41w5EFCvThR'
RECAPTCHA_PRIVATE_KEY='6LfXqAIsAAAAAB8UO_PG7UoqVE2u2v16lQgI9lgx'


# =========================================================
# 📧 CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ---------------------------------------------------------
# EMAIL_HOST_USER:
#   Dirección de correo usada para enviar mensajes automáticos.
#
# EMAIL_HOST_PASSWORD:
#   Contraseña de aplicación (no la personal) generada en Gmail.
#   Se usa para la autenticación SMTP.
#
# DEFAULT_RECIPIENT_EMAIL:
#   Correo predeterminado que recibirá notificaciones o mensajes.
#
# DEFAULT_FROM_EMAIL:
#   Dirección que aparecerá como remitente en los correos enviados
#   desde la aplicación.
#
# 💡 Consejo:
#   Configura Gmail con autenticación de dos pasos y genera una
#   contraseña específica para aplicaciones.
# =========================================================
EMAIL_HOST_USER="karmindco@gmail.com"
EMAIL_HOST_PASSWORD="msbj remw mbrd zxfa"
DEFAULT_RECIPIENT_EMAIL="karmindco@gmail.com"
DEFAULT_FROM_EMAIL="no-reply@karmind.co"
